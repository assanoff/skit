// Package {{.Pkg}}db is the Postgres implementation of {{.Pkg}}core.Store. It maps
// between the domain {{.Type}} and its database representation and uses the
// skit dbx helpers for queries, following the SDK pg-store convention (inline
// const queries, a model.go row type, a map[string]any of named params +
// applyFilter for the dynamic WHERE). It turns the dbx errors into the domain
// sentinels, so the domain never imports dbx.
package {{.Pkg}}db

import (
	"bytes"
	"context"
	"errors"
	"fmt"
	"log/slog"
	"strings"
	"time"
	"uuid"

	"github.com/assanoff/skit/dbx"
	"github.com/assanoff/skit/order"
	"github.com/assanoff/skit/page"
	"github.com/assanoff/skit/queue"

	{{.Pkg}}core "{{.Module}}/core/{{.Pkg}}"
)

// repo is CRUD over the pool or a transaction.
type repo struct {
	log *slog.Logger
	q   dbx.Querier // *dbx.DB or *dbx.Tx
}

// withTx returns a copy of r bound to tx.
func (r *repo) withTx(tx *dbx.Tx) *repo {
	c := *r
	c.q = tx
	return &c
}

// Option configures a Store.
type Option func(*Store)

// WithTasks turns tasks on: WithinTranTasks hands fn the scheduler fn(tx)
// bound to the transaction. Without it Schedule fails.
func WithTasks(fn func(tx *dbx.Tx) *queue.Scheduler) Option {
	return func(s *Store) { s.tasks = fn }
}

// Store implements {{.Pkg}}core.Store against Postgres. Over a pool its
// WithinTran opens a transaction, over a transaction it joins it.
type Store struct {
	*repo

	tasks func(tx *dbx.Tx) *queue.Scheduler
}

// NewStore builds a Store over q: a pool (*dbx.DB) or a transaction
// (*dbx.Tx). The same constructor binds the store to a transaction.
func NewStore(log *slog.Logger, q dbx.Querier, opts ...Option) *Store {
	s := &Store{repo: &repo{log: log, q: q}}
	for _, o := range opts {
		o(s)
	}
	return s
}

// Compile-time check that Store satisfies the domain contract.
var _ {{.Pkg}}core.Store = (*Store)(nil)

// WithinTran implements {{.Pkg}}core.Store.
func (s *Store) WithinTran(ctx context.Context, fn func(r {{.Pkg}}core.Repo) error) error {
	return dbx.WithinTran(ctx, s.log, s.q, func(tx *dbx.Tx) error {
		return fn(s.withTx(tx))
	})
}

// WithinTranTasks implements {{.Pkg}}core.Store.
func (s *Store) WithinTranTasks(ctx context.Context, fn func(r {{.Pkg}}core.Repo, ts {{.Pkg}}core.Scheduler) error) error {
	return dbx.WithinTran(ctx, s.log, s.q, func(tx *dbx.Tx) error {
		return fn(s.withTx(tx), s.scheduler(tx))
	})
}

// scheduler returns the Scheduler bound to tx, or noTasks for a store built
// without WithTasks.
func (s *Store) scheduler(tx *dbx.Tx) {{.Pkg}}core.Scheduler {
	if s.tasks == nil {
		return noTasks{}
	}
	return s.tasks(tx)
}

// errNoTasks is the error of Schedule on a store built without WithTasks.
var errNoTasks = errors.New("{{.Pkg}}db: schedule: the store has no tasks (WithTasks)")

// noTasks is the Scheduler of a store built without WithTasks: Schedule
// fails, so no task is lost in silence.
type noTasks struct{}

func (noTasks) Schedule(context.Context, any) error { return errNoTasks }

// Create implements {{.Pkg}}core.Repo.
func (r *repo) Create(ctx context.Context, v {{.Pkg}}core.{{.Type}}) error {
	const q = `
		INSERT INTO {{.Plural}} (id, name, description, created_at, updated_at)
		VALUES (:id, :name, :description, :created_at, :updated_at)`
	err := dbx.NamedExec(ctx, r.q, q, toDB(v))
	if errors.Is(err, dbx.ErrDBDuplicatedEntry) {
		return fmt.Errorf("create: %w: %w", {{.Pkg}}core.ErrAlreadyExists, err)
	}
	if err != nil {
		return fmt.Errorf("create: %w", err)
	}
	return nil
}

// Update implements {{.Pkg}}core.Repo.
func (r *repo) Update(ctx context.Context, v {{.Pkg}}core.{{.Type}}) error {
	const q = `
		UPDATE {{.Plural}}
		SET name = :name, description = :description, updated_at = :updated_at
		WHERE id = :id`
	n, err := dbx.NamedExecRowsAffected(ctx, r.q, q, toDB(v))
	if err != nil {
		return fmt.Errorf("update: %w", err)
	}
	if n == 0 {
		return fmt.Errorf("update: %w", {{.Pkg}}core.ErrNotFound)
	}
	return nil
}

// Delete implements {{.Pkg}}core.Repo.
func (r *repo) Delete(ctx context.Context, id uuid.UUID) error {
	const q = `DELETE FROM {{.Plural}} WHERE id = :id`
	data := struct {
		ID string `db:"id"`
	}{ID: id.String()}
	n, err := dbx.NamedExecRowsAffected(ctx, r.q, q, data)
	if err != nil {
		return fmt.Errorf("delete: %w", err)
	}
	if n == 0 {
		return fmt.Errorf("delete: %w", {{.Pkg}}core.ErrNotFound)
	}
	return nil
}

// QueryByID implements {{.Pkg}}core.Repo.
func (r *repo) QueryByID(ctx context.Context, id uuid.UUID) ({{.Pkg}}core.{{.Type}}, error) {
	const q = `SELECT id, name, description, created_at, updated_at FROM {{.Plural}} WHERE id = :id`
	data := struct {
		ID string `db:"id"`
	}{ID: id.String()}

	row, err := dbx.NamedQueryOne[db{{.Type}}](ctx, r.q, q, data)
	if errors.Is(err, dbx.ErrDBNotFound) {
		return {{.Pkg}}core.{{.Type}}{}, fmt.Errorf("querybyid: %w", {{.Pkg}}core.ErrNotFound)
	}
	if err != nil {
		return {{.Pkg}}core.{{.Type}}{}, fmt.Errorf("querybyid: %w", err)
	}
	return toCore(row), nil
}

// Count implements {{.Pkg}}core.Repo, honoring filter so a filtered total stays
// consistent with the filtered page.
func (r *repo) Count(ctx context.Context, filter {{.Pkg}}core.QueryFilter) (int, error) {
	data := map[string]any{}
	buf := bytes.NewBufferString(`SELECT count(*) AS n FROM {{.Plural}}`)
	r.applyFilter(filter, data, buf)

	n, err := dbx.NamedQueryOne[int](ctx, r.q, buf.String(), data)
	if err != nil {
		return 0, fmt.Errorf("count: %w", err)
	}
	return n, nil
}

// Query implements {{.Pkg}}core.Repo: one filtered, ordered page. The WHERE is built
// by applyFilter, the ORDER BY by orderByClause (allowlisted), and the pagination
// clause binds :offset and :rows_per_page below.
func (r *repo) Query(ctx context.Context, filter {{.Pkg}}core.QueryFilter, by order.By, pg page.Page) ([]{{.Pkg}}core.{{.Type}}, error) {
	clause, err := orderByClause(by)
	if err != nil {
		return nil, fmt.Errorf("query: %w", err)
	}

	data := map[string]any{
		"offset":        pg.Offset(),
		"rows_per_page": pg.RowsPerPage(),
	}

	buf := bytes.NewBufferString(`SELECT id, name, description, created_at, updated_at FROM {{.Plural}}`)
	r.applyFilter(filter, data, buf)
	buf.WriteString(clause)
	buf.WriteString(" OFFSET :offset ROWS FETCH NEXT :rows_per_page ROWS ONLY")

	rows, err := dbx.NamedQueryList[db{{.Type}}](ctx, r.q, buf.String(), data)
	if err != nil {
		return nil, fmt.Errorf("query: %w", err)
	}
	return toCoreSlice(rows), nil
}

// QueryByCursor implements {{.Pkg}}core.Repo with keyset (cursor) pagination, honoring
// filter. It combines filter's predicates with the keyset boundary in one WHERE,
// fetches one extra row to detect a further page, trims it, and encodes the last
// row's (created_at, id) into the next token. Back it with a composite index on
// ({{.Plural}}) (created_at DESC, id DESC) so it stays O(limit) at any depth.
func (r *repo) QueryByCursor(ctx context.Context, filter {{.Pkg}}core.QueryFilter, cur page.Cursor) ([]{{.Pkg}}core.{{.Type}}, string, error) {
	key, err := cur.Key()
	if err != nil {
		return nil, "", fmt.Errorf("querybycursor: %w", err)
	}

	data := map[string]any{
		"limit": cur.Limit() + 1, // one extra row signals that a next page exists
	}

	// The keyset boundary is just one more predicate alongside filter's: bind its
	// params, then hand it to applyFilter as an extra so it lands in the same WHERE.
	var extra []string
	if key != "" {
		ts, id, decodeErr := decodeCursor(key)
		if decodeErr != nil {
			return nil, "", fmt.Errorf("querybycursor: %w", decodeErr)
		}
		data["after_ts"] = ts
		data["after_id"] = id
		// Rows strictly past the boundary in the (created_at DESC, id DESC) order;
		// the id tiebreaker makes the keyset total so paging never repeats a row.
		// CAST(... AS uuid) — not ::uuid — so sqlx's named-param parser doesn't
		// trip over the `::`.
		extra = append(extra, "(created_at, id) < (:after_ts, CAST(:after_id AS uuid))")
	}

	buf := bytes.NewBufferString(`SELECT id, name, description, created_at, updated_at FROM {{.Plural}}`)
	r.applyFilter(filter, data, buf, extra...)
	buf.WriteString(` ORDER BY created_at DESC, id DESC LIMIT :limit`)

	rows, err := dbx.NamedQueryList[db{{.Type}}](ctx, r.q, buf.String(), data)
	if err != nil {
		return nil, "", fmt.Errorf("querybycursor: %w", err)
	}

	var next string
	if len(rows) > cur.Limit() {
		rows = rows[:cur.Limit()]
		last := rows[len(rows)-1]
		next = page.EncodeCursor(encodeCursor(last.CreatedAt, uuid.UUID(last.ID)))
	}
	return toCoreSlice(rows), next, nil
}

// The dynamic WHERE — applyFilter — lives in filter.go; keyset paging in
// QueryByCursor passes its boundary predicate to applyFilter as an extra so it
// is combined with the filter conditions under one WHERE.

// encodeCursor packs a {{.Pkg}}'s sort key (created_at, id) into the plain string
// that page.EncodeCursor turns into an opaque, URL-safe token.
func encodeCursor(createdAt time.Time, id uuid.UUID) string {
	return createdAt.UTC().Format(time.RFC3339Nano) + "|" + id.String()
}

// decodeCursor parses the key encodeCursor produced back into the boundary
// timestamp and id.
func decodeCursor(key string) (time.Time, string, error) {
	tsStr, idStr, ok := strings.Cut(key, "|")
	if !ok {
		return time.Time{}, "", fmt.Errorf("malformed cursor key %q", key)
	}
	ts, err := time.Parse(time.RFC3339Nano, tsStr)
	if err != nil {
		return time.Time{}, "", fmt.Errorf("malformed cursor timestamp %q: %w", tsStr, err)
	}
	return ts, idStr, nil
}
