// This file is the gRPC bootstrap generated by `skit add grpc`. It assembles the
// gRPC server (the full skit interceptor chain + protovalidate request checks)
// and the gRPC-gateway REST proxy route set with the OpenAPI docs. Wire both
// into the commands as the next-steps describe.
package server

import (
	"context"
	"strings"

	"github.com/assanoff/skit/grpcgateway"
	"github.com/assanoff/skit/grpcserver"
	"github.com/assanoff/skit/rest/router"

	"{{.Module}}/internal/app/deps"
	"{{.Module}}/internal/app/docs"
)

// WithGRPC adds the gRPC server on addr; an empty addr adds none, so clearing
// GRPC_ADDR turns it off. List it in the commands that serve traffic
// (internal/cmd/serve.go, http.go), next to the HTTP server:
//
//	server.WithGRPC(c.GRPC.Addr),
func WithGRPC(addr string) Option {
	return func(ctx context.Context, a *App) error {
		if addr == "" {
			return nil
		}
		a.servers = append(a.servers, buildGRPCServer(ctx, a, addr))
		return nil
	}
}

// buildGRPCServer assembles the gRPC server on addr: the skit interceptor chain
// (recovery, trace, logging, metrics, error-map) plus protovalidate — every
// request message is checked against its .proto buf.validate rules before the
// handler runs, so handlers need not re-check them.
func buildGRPCServer(ctx context.Context, a *App, addr string) *grpcserver.Server {
	gs := grpcserver.New(a.d.Logger, grpcserver.Config{
		Addr:             addr,
		EnableReflection: a.d.Opts.GRPC.Reflection,
	},
		grpcserver.WithTracer(a.d.Tracer(ctx)),
		grpcserver.WithMetrics(a.m.Registry),
		grpcserver.WithProtoValidate(),
	)
	installGRPC(ctx, gs, a.d)
	return gs
}

// installGRPC registers every gRPC feature handler. `skit add grpc <entity>`
// adds one line here per entity — each handler implements grpcserver.Service.
// Build the handler from its Core provider in deps, e.g.:
//
//	gs.Install({{.Pkg}}grpc.New(d.{{.Type}}Core(ctx)))
func installGRPC(ctx context.Context, gs *grpcserver.Server, d *deps.Deps) {
	_, _, _ = ctx, gs, d
	// gs.Install({{.Pkg}}grpc.New(d.{{.Type}}Core(ctx)))
}

// GRPCGateway is the gRPC-gateway REST proxy (/v1/...) to the gRPC server on
// addr and, when GRPC.Docs is set, the OpenAPI spec (/openapi.json) + Swagger UI
// (/docs). Give it the address WithGRPC listens on and list it next to Install,
// so the command is the one place that says where the gateway dials:
//
//	server.WithServer(c.HTTP.Addr, server.Install, server.GRPCGateway(c.GRPC.Addr)),
//	server.WithGRPC(c.GRPC.Addr),
//
// The gateway goes through the request chain, like Install's routes. An empty
// addr mounts nothing, and so does GRPC.Gateway off.
func GRPCGateway(addr string) Routes {
	return func(ctx context.Context, a *App, r *router.Router) {
		if addr == "" || !a.d.Opts.GRPC.Gateway {
			return
		}
		gw, err := grpcgateway.New(ctx, grpcgateway.Config{
			Endpoint: gatewayEndpoint(addr),
		}, gatewayRegistrars()...)
		if err != nil {
			a.d.Logger.Error(ctx, "grpc gateway: build failed", "err", err)
			return
		}
		api := requestChain(ctx, a, r)
		api.Handle("/v1/", gw) // the generated google.api.http rules live under /v1
		if a.d.Opts.GRPC.Docs {
			api.Handle("GET /openapi.json", docs.SpecHandler())
			api.Handle("GET /docs", docs.UIHandler("/openapi.json"))
		}
	}
}

// gatewayRegistrars lists the generated gateway handlers to mount. `skit add
// grpc <entity>` adds one per entity (import the entity's genv1 package):
//
//	{{.Pkg}}v1.Register{{.Type}}ServiceHandler,
func gatewayRegistrars() []grpcgateway.HandlerRegistrar {
	return []grpcgateway.HandlerRegistrar{
		// {{.Pkg}}v1.Register{{.Type}}ServiceHandler,
	}
}

// gatewayEndpoint turns a listen address into a dial target: ":9090" ->
// "localhost:9090" (a client cannot dial a bare-port address).
func gatewayEndpoint(addr string) string {
	if strings.HasPrefix(addr, ":") {
		return "localhost" + addr
	}
	return addr
}
