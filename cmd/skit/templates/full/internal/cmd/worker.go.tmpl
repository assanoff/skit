package cmd

import (
	"{{.Module}}/internal/app/config"
	"{{.Module}}/internal/app/server"
)

// WorkerCommand runs the background work only: domain loops and the
// transactional-outbox workers, plus the technical routes on DEBUG_ADDR. No API,
// no consumers.
//
// Run it as a single replica — see initWorkers (internal/app/server/server.go).
type WorkerCommand struct {
	config.ServerOpts
}

// Execute implements flags.Commander.
func (c *WorkerCommand) Execute(_ []string) error {
	return run(c.ServerOpts,
		server.WithServer(c.Debug.Addr, server.Debug),
		server.WithWorkers(),
	)
}
