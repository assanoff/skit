package cmd

import (
	"fmt"

	"github.com/assanoff/skit/buildinfo"
)

// VersionCommand prints the build: the version, the VCS revision and time,
// and the Go version. A build without .git stamps its version with
// -ldflags "-X github.com/assanoff/skit/buildinfo.version=...".
type VersionCommand struct{}

// Execute implements flags.Commander.
func (VersionCommand) Execute([]string) error {
	fmt.Println("{{.Name}}", buildinfo.Read())
	return nil
}
