package cmd

import (
	"{{.Module}}/internal/app/config"
	"{{.Module}}/internal/app/server"
)

// ConsumerCommand runs the queue consumers only, plus the technical routes on
// DEBUG_ADDR. No API, no background workers. Consumers are competing consumers,
// so more than one replica is safe.
type ConsumerCommand struct {
	config.ServerOpts
}

// Execute implements flags.Commander.
func (c *ConsumerCommand) Execute(_ []string) error {
	return run(c.ServerOpts,
		server.WithServer(c.Debug.Addr, server.Debug),
		server.WithConsumers(),
	)
}
