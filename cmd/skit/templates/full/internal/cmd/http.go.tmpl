package cmd

import (
	"{{.Module}}/internal/app/config"
	"{{.Module}}/internal/app/server"
)

// HTTPCommand serves the API and the technical routes only: no background
// workers, no queue consumers. Safe to scale to N replicas — nothing in this
// process polls the database on a timer.
type HTTPCommand struct {
	config.ServerOpts
}

// Execute implements flags.Commander.
func (c *HTTPCommand) Execute(_ []string) error {
	return run(c.ServerOpts,
		server.WithServer(c.HTTP.Addr, server.Install),
		server.WithServer(c.Debug.Addr, server.Debug),
	)
}
