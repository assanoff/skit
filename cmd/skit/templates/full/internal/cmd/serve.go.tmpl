package cmd

import (
	"{{.Module}}/internal/app/config"
	"{{.Module}}/internal/app/server"
)

// ServeCommand runs everything in one process: the API, the technical routes,
// background workers and queue consumers. This is the default for local
// development and single-pod deployments; the http / worker / consumer
// commands split the same binary across pods.
type ServeCommand struct {
	config.ServerOpts
}

// Execute implements flags.Commander.
func (c *ServeCommand) Execute(_ []string) error {
	return run(c.ServerOpts,
		server.WithServer(c.HTTP.Addr, server.Install),
		server.WithServer(c.Debug.Addr, server.Debug),
		server.WithWorkers(),
		server.WithConsumers(),
	)
}
