// Package {{.Pkg}} is a scheduled job: it runs Cron.run on a wall-clock
// schedule via a cron.Scheduler (a supervised worker.Runnable).
{{if .Locked}}//
// It is lock-guarded, so across a fleet the job fires on at most one replica per
// tick: each tick tries a lock.Locker and skips if another replica holds it.
// The winner keeps the lock for lockHold even when the job ends sooner, so a
// replica whose tick fires a moment later still finds it held. That needs a
// schedule that ticks on every replica at once: five fields or a descriptor
// such as @hourly, not @every, which counts from the start of each replica.
{{end}}package {{.Pkg}}

import (
	"context"
	"log/slog"
	{{if .Locked}}"time"
{{end}}
	"github.com/prometheus/client_golang/prometheus"
	"go.opentelemetry.io/otel/trace"

	"github.com/assanoff/skit/cron"
	{{if .Locked}}"github.com/assanoff/skit/lock"
{{end}})

// Schedule is the cron spec this job runs on: standard 5-field cron
// (min hour dom month dow) or an @-descriptor (@hourly, @daily, @every 1h30m).
const Schedule = "{{.Schedule}}"

// Name identifies the job in logs{{if .Locked}} and is the lock key{{end}}.
const Name = "{{.Pkg}}"

// Cron holds the job's dependencies. Add the collaborators run needs (stores,
// clients, cores) as fields and set them in New.
type Cron struct {
	log *slog.Logger
{{if .Locked}}	locker   lock.Locker
	lockTTL  time.Duration
	lockHold time.Duration
{{end}}}

// New builds the job.
func New(log *slog.Logger{{if .Locked}}, locker lock.Locker{{end}}) *Cron {
	return &Cron{
		log: log,
{{if .Locked}}		locker: locker,
		// lockTTL bounds how long a crashed holder blocks others (redis; the
		// pg backend ignores it); keep it above lockHold.
		lockTTL: time.Minute,
		// lockHold outlasts the spread of the replicas' ticks and stays under
		// the shortest tick of the schedule.
		lockHold: 30 * time.Second,
{{end}}	}
}

// run performs one invocation of the scheduled work.
func (c *Cron) run(ctx context.Context) error {
	// TODO: the scheduled work goes here.
	c.log.InfoContext(ctx, "cron tick", "job", Name)
	return nil
}
{{if .Locked}}
// guarded runs the job only if this replica wins the lock, so it fires on at
// most one replica per tick. A tick that misses the lock is skipped (the job is
// periodic — the next holder runs it next tick). The lock is kept for lockHold
// from the win even when the job ends sooner: released at once, it would let a
// replica whose tick fires a moment later run the job again.
func (c *Cron) guarded(ctx context.Context) error {
	release, ok, err := c.locker.TryLock(ctx, Name, c.lockTTL)
	if err != nil {
		return err
	}
	if !ok {
		c.log.DebugContext(ctx, "cron tick skipped: lock held elsewhere", "job", Name)
		return nil
	}
	hold := time.After(c.lockHold)
	defer func() { go releaseAfter(ctx, hold, release) }()
	return c.run(ctx)
}

// releaseAfter frees the lock when hold fires, or at once when ctx ends (the
// service stops). It runs in the background, so the run of the job is measured
// without the hold.
func releaseAfter(ctx context.Context, hold <-chan time.Time, release lock.Release) {
	select {
	case <-hold:
	case <-ctx.Done():
	}
	release()
}
{{end}}
// Scheduler builds the cron scheduler Runnable for this job. Add the returned
// value to the service's worker group. reg is the registry of the run metrics
// (skit_cron_*, pass Deps.Metrics); nil disables them. Every run is the root
// span of its own trace on tp (pass Deps.TracerProvider).
func (c *Cron) Scheduler(reg prometheus.Registerer, tp trace.TracerProvider) (*cron.Scheduler, error) {
	sched := cron.New(c.log, cron.Config{Name: Name, Metrics: reg, TracerProvider: tp})
	if err := sched.Add(Schedule, Name, c.{{if .Locked}}guarded{{else}}run{{end}}); err != nil {
		return nil, err
	}
	return sched, nil
}
