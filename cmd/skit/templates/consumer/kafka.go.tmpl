package {{.Pkg}}

import (
	"github.com/prometheus/client_golang/prometheus"
	"go.opentelemetry.io/otel/trace"

	"github.com/assanoff/skit/broker/kafka"

	"{{.Module}}/internal/app/config"
)

// Runnable builds the Kafka consumer of Handle from config: the consumer group
// opts.Group reads the topic opts.Topic on the brokers of cfg; Kafka has no
// filters, so opts.Filters is ignored. Register it on the worker group. Every
// attempt at a record is recorded in skit_broker_* on reg (a nil reg turns the
// metrics off) and as a span on tp, in the trace the message was created in. A
// broker swap replaces this file; Handle in {{.Pkg}}.go stays untouched.
func (c *Consumer) Runnable(cfg kafka.Config, opts config.ConsumerOpts, reg prometheus.Registerer, tp trace.TracerProvider) (*kafka.Consumer, error) {
	return kafka.NewConsumer(c.log, cfg, kafka.ConsumerConfig{
		Topic:          opts.Topic,
		Group:          opts.Group,
		Concurrency:    opts.Concurrency,
		Name:           "{{.Pkg}}-consumer",
		Metrics:        reg,
		TracerProvider: tp,
	}, c.Handle)
}
