package {{.Pkg}}

import (
	"github.com/prometheus/client_golang/prometheus"
	"go.opentelemetry.io/otel/trace"

	"github.com/assanoff/skit/broker/rabbitmq"

	"{{.Module}}/internal/app/config"
)

// Runnable builds the RabbitMQ consumer of Handle from config: the queue
// opts.Group bound to the exchange opts.Topic by the routing keys opts.Filters
// (every key when none are given). Register it on the worker group. Every
// message is recorded in skit_broker_* on reg (a nil reg turns the metrics off)
// and as a span on tp, in the trace the message was created in. A broker swap
// replaces this file; Handle in {{.Pkg}}.go stays untouched.
func (c *Consumer) Runnable(conn *rabbitmq.Conn, opts config.ConsumerOpts, reg prometheus.Registerer, tp trace.TracerProvider) (*rabbitmq.Consumer, error) {
	return rabbitmq.NewConsumer(c.log, conn, rabbitmq.ConsumerConfig{
		Queue:          opts.Group,
		Exchange:       opts.Topic,
		RoutingKeys:    opts.Filters,
		Concurrency:    opts.Concurrency,
		Name:           "{{.Pkg}}-consumer",
		Metrics:        reg,
		TracerProvider: tp,
	}, c.Handle)
}
