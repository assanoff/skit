// Package {{.Pkg}} is a queue-backed worker: it defines a queue.JobFunc for its
// task kind, run by the workers of its queue (queue.Workers) with lease-based,
// multi-replica-safe delivery. Producers enqueue work with
// q.Schedule(ctx, queue.Params{Queue: {{.Pkg}}.Queue, Kind: {{.Pkg}}.Kind, Payload: ...}).
package {{.Pkg}}

import (
	"context"
	"encoding/json/v2"
	"fmt"
	"log/slog"

	"github.com/assanoff/skit/queue"
)

const (
	// Queue is the queue of the {{.Pkg}} tasks, with its own workers: give slow
	// and fast work queues of their own.
	Queue = "{{.Pkg}}"
	// Kind routes the tasks of Queue to this worker's handler (see queue.Mux).
	Kind = "{{.Pkg}}"
)

// Worker handles claimed {{.Pkg}} tasks.
type Worker struct {
	log *slog.Logger
	// core *{{.Pkg}}core.Core // inject the domain core the handler drives
}

// New builds the {{.Pkg}} worker.
func New(log *slog.Logger) *Worker {
	return &Worker{log: log}
}

// Task is the JSON payload carried in queue.Task.Payload.
type Task struct {
	// TODO: task fields, e.g.
	// ID string `json:"id"`
}

// Handle processes one claimed task; it is a queue.JobFunc. nil removes the
// task; an error retries it with backoff; queue.Permanent sends it to the dead
// letters; queue.Halt also stops the batch, for a dependency every task needs
// that is down.
func (w *Worker) Handle(ctx context.Context, t queue.Task) error {
	var payload Task
	if err := json.Unmarshal(t.Payload, &payload); err != nil {
		return queue.Permanent(fmt.Errorf("decode {{.Pkg}} task %d: %w", t.ID, err))
	}

	// TODO: drive the domain, e.g. return w.core.Do(ctx, payload)
	w.log.InfoContext(ctx, "{{.Pkg}} task handled", "task", t.ID, "attempts", t.Attempts)
	return nil
}
