package {{.Pkg}}

import (
	"context"
	"encoding/json/v2"
	"testing"
	"uuid"

	"github.com/matryer/is"

	"github.com/assanoff/skit/broker"
	"github.com/assanoff/skit/outbox"
	"github.com/assanoff/skit/queue"

	"{{.Module}}/core/{{.Core}}"
)

// recorder records the message it is asked to publish.
type recorder struct{ m broker.Message }

func (r *recorder) Publish(_ context.Context, m broker.Message) error {
	r.m = m
	return nil
}

// TestPublish checks the event routes into the queue of events, has its
// handler there and reaches the broker with its type, its topic and its
// payload in the CloudEvents `data`.
func TestPublish(t *testing.T) {
	is := is.New(t)
	ctx := context.Background()
	reg, mux, pub := queue.NewRegistry(), queue.NewMux(), &recorder{}
	is.NoErr(Route(reg, "events", queue.WithEncoder(outbox.JSON)))
	is.NoErr(Handle(mux, pub))
	is.NoErr(reg.Check("events", mux)) // the event has its handler

	in := {{.Core}}.{{.Type}}{ID: uuid.New()}
	payload, err := outbox.JSON(ctx, in)
	is.NoErr(err)
	is.NoErr(mux.Handle(ctx, queue.Task{Kind: EventType, Payload: payload}))

	is.Equal(pub.m.Type, EventType)
	is.Equal(pub.m.Topic, Topic)
	var out {{.Core}}.{{.Type}}
	is.NoErr(json.Unmarshal(pub.m.Data, &out))
	is.Equal(out.ID, in.ID) // the payload survives the envelope
}
