// Package {{.Pkg}} registers the outbox route of the {{.Core}}.{{.Type}} event:
// its CloudEvents type and topic. The event type lives in the domain
// (core/{{.Core}}), which imports neither outbox nor this package; the relay
// delivers the stored event to the broker, and a consumer decodes the
// CloudEvents envelope on the other side (see `skit add consumer`).
package {{.Pkg}}

import (
	"github.com/assanoff/skit/outbox"

	"{{.Module}}/core/{{.Core}}"
)

// EventType is the CloudEvents `type` for this event — the stable name other
// services filter and route on. Namespaced by the aggregate.
const EventType = "{{.Plural}}.created" // TODO: name the real event, e.g. "{{.Plural}}.updated"

// Topic is the transport destination the relay publishes this event to.
const Topic = "{{.Plural}}"

// Register maps {{.Core}}.{{.Type}} to its CloudEvents type and topic on reg.
// Call it once at startup, before the relay starts, so the outbox knows how to
// route the event. The payload is JSON.
//
// The broker publisher derives any key from the message: Kafka keeps the
// events of one aggregate in order with kafka.WithPartitionKey.
func Register(reg *outbox.Registry) error {
	return reg.Register[{{.Core}}.{{.Type}}](EventType, Topic)
}
