          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max by (cron_job) (skit_cron_last_success_timestamp_seconds{namespace=~\"$namespace\", job=~\"$job\", pod=~\"$pod\"})",
          "legendFormat": "{{cron_job}}",
          "refId": "A"
        }
      ]
    }
  ]
}
